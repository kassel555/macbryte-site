---
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import FirstStep from '../components/FirstStep.astro';
import { site, services } from '../data/site';

const title = 'Computer Lessons for Seniors in Ottawa — Mac or PC | Macbryte';
const description = 'Patient one-on-one computer lessons for seniors and beginners in Ottawa, Kanata, Nepean and Barrhaven. Mac, PC, iPad and iPhone — at home or online. Call 613-702-7712.';

const areas = [
  ['/computer-coaching-ottawa', 'Ottawa'], ['/computer-coaching-kanata', 'Kanata'],
  ['/computer-coaching-barrhaven', 'Barrhaven'], ['/computer-coaching-nepean', 'Nepean'],
];

const faqs = [
  { q: 'Do you teach Mac or PC?', a: 'Both. Many students use a Mac, iPad or iPhone, and we teach Windows PCs too. We work on the device you already own.' },
  { q: 'What areas do you serve?', a: 'Ottawa, Kanata, Nepean and Barrhaven, in your home. Online lessons are available anywhere.' },
  { q: 'Do I need any experience?', a: 'None at all. Lessons go at your pace, in plain language, and you can ask the same question as many times as you need.' },
  { q: 'How much does it cost?', a: 'Lessons are $85 per hour, with savings on 4, 8 and 12-hour packages. The first phone call is free.' },
  { q: 'What should I have ready for the first lesson?', a: 'Your device, its charger, and any passwords you know. If you are not sure of a password, that is fine — we can sort it out together.' },
  { q: 'Can a family member book for me?', a: 'Yes. Many first calls come from a son or daughter. We will talk with you both and plan lessons around what you want to learn.' },
];

const posts = [
  ['/blog/mac-vs-pc-which-is-right-for-you', 'Mac vs. PC: Which computer is right for you?'],
  ['/blog/how-to-spot-scam-emails', 'How to spot a scam email (and what to do about it)'],
  ['/blog/video-calling-your-grandkids', 'How to video call your grandkids, step by step'],
];

const jsonld = [
  JSON.stringify({
    '@context': 'https://schema.org', '@type': 'LocalBusiness', name: 'Macbryte',
    description: 'One-on-one computer lessons for seniors and beginners — Mac, PC, iPad and iPhone — in Ottawa, Kanata, Nepean and Barrhaven.',
    url: site.url, telephone: '+1-613-702-7712', email: site.email, image: site.url + '/og-image.jpg', priceRange: '$85–$925',
    address: { '@type': 'PostalAddress', addressLocality: 'Ottawa', addressRegion: 'ON', addressCountry: 'CA' },
    areaServed: site.areas.map((name) => ({ '@type': 'City', name })),
  }),
  JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }),
];
---
<Base title={title} description={description} path="/" jsonld={jsonld}>
  <!-- Hero -->
  <section class="px-4 md:px-8 pt-12 pb-14 md:pt-20 md:pb-20 bg-gradient-to-b from-white to-[#f2f1fa]">
    <div class="max-w-6xl mx-auto grid gap-12 md:grid-cols-[1.25fr_1fr] items-center">
      <div>
        <p class="text-coral-dark font-semibold uppercase tracking-wide text-sm mb-4">Ottawa · Kanata · Nepean · Barrhaven</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight text-gray-900 mb-6">
          Patient computer lessons, <span class="text-coral-dark whitespace-nowrap">one-on-one</span>.
        </h1>
        <p class="text-xl text-gray-700 mb-8 max-w-xl">For seniors and anyone who wants technology to make life easier. Mac or PC, iPad or iPhone — at your kitchen table or online, at your own pace.</p>
        <div class="flex flex-col sm:flex-row gap-3 mb-4">
          <a href={site.phoneHref} class="inline-flex justify-center items-center gap-2 rounded-full bg-coral-dark hover:bg-coral text-white font-semibold px-8 py-4 text-xl">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call {site.phone}
          </a>
          <a href="/contact" class="inline-flex justify-center items-center rounded-full border-2 border-gray-900 text-gray-900 font-semibold px-8 py-4 text-xl hover:bg-gray-900 hover:text-white">Request a callback</a>
        </div>
        <p class="text-gray-600">The first 15-minute call is free. No technical knowledge needed.</p>
      </div>

      <!-- Coach card -->
      <aside class="bg-white rounded-3xl shadow-xl p-7">
        <div class="flex items-center gap-4 mb-5">
          {site.coach.photo
            ? <img src={site.coach.photo} alt={`${site.coach.name}, your Macbryte coach`} width="128" height="128" class="w-32 h-32 rounded-full object-cover ring-4 ring-[#f2f1fa]" />
            : <div class="w-20 h-20 rounded-full bg-[#f2f1fa] text-[#6B5CE7] text-3xl font-bold flex items-center justify-center" aria-hidden="true">{site.coach.name[0]}</div>}
          <div>
            <p class="text-sm text-gray-500 uppercase tracking-wide">Your coach</p>
            <p class="text-2xl font-bold text-gray-900">{site.coach.name}</p>
            <p class="text-gray-600">Founder of Macbryte</p>
          </div>
        </div>
        <p class="text-gray-700 mb-6">One student at a time, on the device you already own. Lessons go slowly, steps get written down, and anything can be repeated as often as you like.</p>
        <dl class="grid grid-cols-2 gap-4 text-center">
          <div class="bg-[#f8f7fc] rounded-2xl py-4"><dt class="text-gray-600 text-sm">Students taught</dt><dd class="text-3xl font-bold text-coral-dark">{site.stats.students}</dd></div>
          <div class="bg-[#f8f7fc] rounded-2xl py-4"><dt class="text-gray-600 text-sm">Hours of lessons</dt><dd class="text-3xl font-bold text-coral-dark">{site.stats.hours}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- Testimonials up front -->
  <Testimonials heading="Students in their own words" />

  <!-- Mac or PC -->
  <section class="px-4 md:px-8 py-14 bg-[#f8f7fc]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-gray-900 text-center mb-3">Mac or PC — we teach the one you have</h2>
      <p class="text-center text-gray-600 max-w-2xl mx-auto mb-10">Bring any device. Lessons are built around what you actually want to do with it.</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Mac', 'MacBook, iMac or Mac mini — from the basics to Photos, Mail and Keynote.'],
          ['Windows PC', 'Desktop or laptop — files, email, the internet and staying safe.'],
          ['iPad', 'Gestures, apps, settings, FaceTime and keeping photos in one place.'],
          ['iPhone & Android', 'Calls, texts, the camera, WhatsApp and avoiding scam messages.'],
        ].map(([t, d]) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm"><h3 class="text-xl font-bold text-gray-900 mb-2">{t}</h3><p class="text-gray-600 text-base">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="px-4 md:px-8 py-14 bg-white">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-gray-900 text-center mb-3">What would you like help with?</h2>
      <p class="text-center text-gray-600 max-w-2xl mx-auto mb-10">Popular lessons — each taught patiently, one-on-one, in plain language.</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <a href={s.href} class="group bg-gray-50 hover:bg-[#f2f1fa] border border-gray-100 rounded-2xl p-6 transition-colors">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{s.title}</h3>
            <p class="text-gray-600 text-base mb-4">{s.text}</p>
            <span class="font-semibold text-coral-dark group-hover:underline">Learn more →</span>
          </a>
        ))}
      </div>
      <p class="text-center mt-8"><a href="/what-you-learn" class="font-semibold text-[#6B5CE7] hover:underline">See all beginner courses →</a></p>
    </div>
  </section>

  <FirstStep />

  <!-- Areas -->
  <section class="px-4 md:px-8 py-14 bg-white">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-gray-900 mb-3">In-home lessons across Ottawa</h2>
      <p class="text-gray-600 max-w-2xl mx-auto mb-8">Your coach comes to you. Online lessons work from anywhere.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {areas.map(([href, label]) => (
          <a href={href} class="bg-gray-50 hover:bg-[#f2f1fa] border border-gray-100 rounded-2xl p-5">
            <span class="block text-xl font-bold text-gray-900">{label}</span>
            <span class="text-gray-600 text-base">Lessons in {label} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-4 md:px-8 py-14 bg-[#f8f7fc]">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-gray-900 text-center mb-8">Common questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="bg-white rounded-2xl border border-gray-100 p-5 group">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-4 text-lg font-semibold text-gray-900">{f.q}<span class="text-coral-dark text-2xl group-open:rotate-45 transition-transform" aria-hidden="true">+</span></summary>
            <p class="mt-3 text-gray-700">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Tips -->
  <section class="px-4 md:px-8 py-14 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-gray-900 text-center mb-8">Free tips from your coach</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {posts.map(([href, t]) => (
          <a href={href} class="rounded-2xl border border-gray-100 bg-gray-50 hover:bg-[#f2f1fa] p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">{t}</h3>
            <span class="font-semibold text-coral-dark">Read the tip →</span>
          </a>
        ))}
      </div>
      <p class="text-center mt-8"><a href="/blog" class="font-semibold text-[#6B5CE7] hover:underline">All 12 tips →</a></p>
    </div>
  </section>
</Base>
