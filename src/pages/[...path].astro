---
// Every content page carried over from the original site lives in src/html/<slug>.html.
// Edit those HTML files directly to change page copy. Titles/descriptions live in src/data/pages.json.
import Base from '../layouts/Base.astro';
import pages from '../data/pages.json';
import Testimonials from '../components/Testimonials.astro';
import FirstStep from '../components/FirstStep.astro';

const files = import.meta.glob('../html/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export function getStaticPaths() {
  return Object.keys(pages).map((route) => ({ params: { path: route.slice(1) }, props: { route } }));
}
const { route } = Astro.props;
const p = (pages as any)[route];
const html = files[`../html/${p.slug}.html`];
---
<Base title={p.title} description={p.description} path={route} ogImage={p.ogImage} jsonld={p.jsonld}>
  <Fragment set:html={html} />
  {route === '/pricing' && <><Testimonials heading="Why students keep coming back" /><FirstStep heading="Want to talk it over before you buy?" /></>}
</Base>
