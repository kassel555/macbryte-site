---
// One template for every tip/blog post. Copy lives in src/posts/<slug>.html; metadata in src/data/posts.json.
import Base from '../../layouts/Base.astro';
import posts from '../../data/posts.json';
import { site } from '../../data/site';

const bodies = import.meta.glob('../../posts/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const post = posts.find((p) => p.slug === Astro.props.slug)!;
const body = bodies[`../../posts/${post.slug}.html`];
const url = `${site.url}/blog/${post.slug}`;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
const related = [
  ...posts.filter((p) => p.slug !== post.slug && p.category === post.category),
  ...posts.filter((p) => p.slug !== post.slug && p.category !== post.category),
].slice(0, 3);

const author = {
  '@type': 'Person', '@id': `${site.url}/about#rahul`, name: site.coach.name, jobTitle: 'Co-Founder and Computer Coach',
  url: `${site.url}/about`, image: site.url + site.coach.photo, worksFor: { '@id': `${site.url}/#business` },
};
const jsonld = [
  JSON.stringify({
    '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': url + '#article',
    headline: post.title, description: post.description, image: site.url + post.image,
    datePublished: post.date, dateModified: post.updated, inLanguage: 'en-CA',
    mainEntityOfPage: url, articleSection: post.category, author,
    publisher: { '@type': 'Organization', '@id': `${site.url}/#business`, name: 'Macbryte', logo: { '@type': 'ImageObject', url: site.url + '/images/logo.png' } },
    ...(post.quickAnswer ? { abstract: post.quickAnswer } : {}),
  }),
  JSON.stringify({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Tips', item: site.url + '/blog' },
      { '@type': 'ListItem', position: 3, name: post.title, item: url },
    ],
  }),
  ...(post.faqs.length ? [JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: post.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })] : []),
];
---
<Base title={post.seoTitle} description={post.description} path={`/blog/${post.slug}`} ogImage={post.image} jsonld={jsonld}>
  <nav aria-label="Breadcrumb" class="max-w-3xl mx-auto px-4 pt-6 text-sm text-gray-500">
    <ol class="flex flex-wrap gap-1.5">
      <li><a class="hover:underline" href="/">Home</a> ›</li>
      <li><a class="hover:underline" href="/blog">Tips</a> ›</li>
      <li aria-current="page" class="text-gray-700">{post.title}</li>
    </ol>
  </nav>

  <article class="max-w-3xl mx-auto px-4 pt-6 pb-14">
    <header class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-coral-dark mb-3">{post.category}</p>
      <h1 class="text-gray-900 leading-tight mb-5">{post.title}</h1>
      <div class="flex items-center gap-3 text-gray-600">
        <img src={site.coach.photo} alt="" width="44" height="44" class="w-11 h-11 rounded-full object-cover" />
        <p class="text-base">By <a href="/about" class="font-semibold text-gray-900 hover:underline">{site.coach.name}</a>, Macbryte · <time datetime={post.updated}>Updated {fmt(post.updated)}</time></p>
      </div>
    </header>

    {post.quickAnswer && (
      <aside class="mb-10 rounded-2xl border-l-4 border-coral-dark bg-[#fff6f3] p-6" aria-label="Quick answer">
        <p class="font-bold text-gray-900 mb-2">Quick answer</p>
        <p class="text-gray-800">{post.quickAnswer}</p>
      </aside>
    )}

    <div class="prose-mb text-lg" set:html={body} />

    {post.faqs.length > 0 && (
      <section class="mt-12" aria-labelledby="faq">
        <h2 id="faq" class="text-2xl font-bold text-gray-900 mb-5">Common questions</h2>
        <div class="space-y-3">
          {post.faqs.map((f) => (
            <details class="bg-white rounded-2xl border border-gray-200 p-5 group">
              <summary class="cursor-pointer list-none flex justify-between gap-4 font-semibold text-gray-900 text-lg">{f.q}<span class="text-coral-dark text-2xl group-open:rotate-45 transition-transform" aria-hidden="true">+</span></summary>
              <p class="mt-3 text-gray-700">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {post.sources.length > 0 && (
      <section class="mt-10 text-base text-gray-600">
        <h2 class="text-lg font-semibold text-gray-900 mb-2">Sources</h2>
        <ul class="list-disc pl-6">
          {post.sources.map((s) => <li><a class="underline" href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}
        </ul>
      </section>
    )}

    <!-- Author box -->
    <section class="mt-12 rounded-2xl bg-[#f8f7fc] p-6 flex gap-5 items-start">
      <img src={site.coach.photo} alt={`${site.coach.name}, Macbryte coach`} width="80" height="80" class="w-20 h-20 rounded-full object-cover shrink-0" />
      <div>
        <p class="font-bold text-gray-900 text-lg">Written by {site.coach.name}, Co-Founder of Macbryte</p>
        <p class="text-gray-700 text-base mb-3">Rahul teaches seniors and beginners across Ottawa to use their Mac, PC, iPad and iPhone with confidence — one-on-one, at home or online. {site.stats.students} students, {site.stats.hours} hours of lessons.</p>
        <div class="flex flex-wrap gap-3">
          <a href="/contact" class="rounded-full bg-coral-dark hover:bg-coral text-white font-semibold px-5 py-2.5">Book a Free Call</a>
          <a href={site.phoneHref} class="rounded-full border-2 border-gray-900 font-semibold px-5 py-2">Call {site.phone}</a>
        </div>
      </div>
    </section>
  </article>

  <section class="bg-white px-4 py-12">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">More tips you might like</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {related.map((r) => (
          <a href={`/blog/${r.slug}`} class="rounded-2xl border border-gray-100 bg-gray-50 hover:bg-[#f2f1fa] p-5">
            <p class="text-sm font-semibold text-coral-dark mb-2">{r.category}</p>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{r.title}</h3>
            <p class="text-gray-600 text-base">{r.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
