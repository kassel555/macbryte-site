---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const field = 'w-full rounded-xl border-2 border-gray-300 bg-white px-4 py-3.5 text-lg focus:border-[#6B5CE7]';
const label = 'block text-lg font-semibold text-gray-900 mb-2';
---
<Base title="Contact Macbryte — Request a Free Call | Ottawa Computer Lessons" description="Call 613-702-7712 or request a free 15-minute callback about one-on-one computer lessons for seniors in Ottawa, Kanata, Nepean and Barrhaven." path="/contact">
  <section class="px-4 md:px-8 py-12 md:py-16 bg-gradient-to-b from-white to-[#f2f1fa]">
    <div class="max-w-5xl mx-auto grid gap-12 md:grid-cols-[1fr_1.2fr]">
      <div>
        <h1 class="text-gray-900 mb-5">Let's talk</h1>
        <p class="text-xl text-gray-700 mb-8">The quickest way is to pick up the phone. If we miss you, leave a message and we'll call you back.</p>
        <a href={site.phoneHref} class="inline-flex items-center gap-3 rounded-full bg-coral-dark hover:bg-coral text-white font-bold px-8 py-5 text-2xl mb-8">
          <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {site.phone}
        </a>
        <p class="text-gray-700 mb-2">Prefer email? <a class="text-[#6B5CE7] underline" href={`mailto:${site.email}`}>{site.email}</a></p>
        <ul class="mt-8 space-y-3 text-gray-700">
          <li>✓ First 15-minute call is free</li>
          <li>✓ In-home lessons in {site.areas.join(', ')}</li>
          <li>✓ Online lessons from anywhere</li>
          <li>✓ Mac, PC, iPad, iPhone and Android</li>
        </ul>
      </div>

      <form name="callback" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="company" class="bg-white rounded-3xl shadow-xl p-6 md:p-8 space-y-6">
        <input type="hidden" name="form-name" value="callback" />
        <p class="hidden"><label>Leave this empty: <input name="company" /></label></p>
        <h2 class="text-2xl font-bold text-gray-900">Request a callback</h2>
        <div>
          <label class={label} for="name">Your name</label>
          <input class={field} id="name" name="name" autocomplete="name" required />
        </div>
        <div>
          <label class={label} for="phone">Phone number</label>
          <input class={field} id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <div>
          <label class={label} for="when">Best time to call</label>
          <select class={field} id="when" name="best_time">
            <option>Any time</option><option>Morning</option><option>Afternoon</option><option>Evening</option>
          </select>
        </div>
        <div>
          <label class={label} for="help">What would you like help with?</label>
          <textarea class={field} id="help" name="message" rows="4" placeholder="For example: sending photos from my iPad, or setting up my new Mac"></textarea>
        </div>
        <input type="hidden" name="package" id="package" />
        <button type="submit" class="w-full rounded-full bg-coral-dark hover:bg-coral text-white font-bold py-4 text-xl">Please call me</button>
        <p class="text-sm text-gray-500">We only use your details to call you back.</p>
      </form>
    </div>
  </section>
  <script is:inline>
    // Prefill from links like /contact?package=8-hours or ?topic=Email%20Help
    (function () {
      var q = new URLSearchParams(location.search);
      var pkg = q.get('package'), topic = q.get('topic');
      if (pkg) { document.getElementById('package').value = pkg; document.getElementById('help').value = 'Interested in the ' + pkg.replace('-', ' ') + ' package.'; }
      else if (topic) { document.getElementById('help').value = topic.replace(/ Request$/, '') + ': '; }
      document.querySelector('form[name=callback]').addEventListener('submit', function () { if (window.gtag) gtag('event', 'callback_request'); });
    })();
  </script>
</Base>
