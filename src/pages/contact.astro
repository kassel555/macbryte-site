---
// contact.astro - Contact & Booking page
import Base from '../layouts/Base.astro';
import businessData from '../data/business.json';

const business = businessData.business;
---

<Base
  title="Contact &amp; Booking"
  description="Book your free 15-minute consultation with MacBryte. Personalized technology coaching for seniors in Ottawa, Barrhaven, Nepean, and Kanata."
  schemaType="LocalBusiness"
/>
  <header class="page-header">
    <div class="container">
      <h1>Contact &amp; Booking</h1>
      <p class="page-subtitle">Your first 15-minute consultation is free. No pressure, no commitment.</p>
    </div>
  </header>

  <main class="container contact-content">
    <article class="contact-main">
      <section class="contact-section" aria-labelledby="booking-heading">
        <h2 id="booking-heading">Book Your Free Consultation</h2>
        <p class="section-lead">
          We'll chat by phone or Zoom about your device, your goals, and your comfort level. 
          No sales pitch — just a conversation to see if we're a good fit.
        </p>
        
        <form class="contact-form" action="https://formspree.io/f/your-form-id" method="POST" id="booking-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name <span class="required" aria-hidden="true">*</span></label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder="Jane Smith" />
            </div>
            <div class="form-group">
              <label for="email">Email Address <span class="required" aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="jane@email.com" />
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label for="phone">Phone Number <span class="required" aria-hidden="true">*</span></label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="(613) 555-0123" />
            </div>
            <div class="form-group">
              <label for="preferred">Preferred Contact Method</label>
              <select id="preferred" name="preferred">
                <option value="phone">Phone Call</option>
                <option value="email">Email</option>
                <option value="zoom">Zoom Video Call</option>
                <option value="facetime">FaceTime</option>
              </select>
            </div>
          </div>
          
          <div class="form-group">
            <label for="device">What Device(s) Do You Use?</label>
            <select id="device" name="device" multiple>
              <option value="ipad">iPad</option>
              <option value="iphone">iPhone</option>
              <option value="mac">Mac Computer</option>
              <option value="windows">Windows Computer</option>
              <option value="android">Android Phone/Tablet</option>
              <option value="not-sure">Not Sure / Planning to Buy</option>
            </select>
            <p class="form-hint">Hold Ctrl/Cmd to select multiple</p>
          </div>
          
          <div class="form-group">
            <label for="goals">What Would You Like to Learn? <span class="required" aria-hidden="true">*</span></label>
            <textarea id="goals" name="goals" required rows="4" placeholder="e.g., I want to learn FaceTime to video call my grandkids in Toronto. I also need help with email and organizing photos."></textarea>
          </div>
          
          <div class="form-group">
            <label for="location">Your Location (for in-home sessions)</label>
            <input type="text" id="location" name="location" autocomplete="address-level2" placeholder="e.g., Barrhaven, Ottawa" />
            <p class="form-hint">I serve Ottawa, Barrhaven, Nepean, and Kanata. Virtual sessions available anywhere in Canada.</p>
          </div>
          
          <div class="form-group">
            <label for="availability">Preferred Days/Times</label>
            <textarea id="availability" name="availability" rows="2" placeholder="e.g., Weekday mornings, or Saturday afternoons"></textarea>
            <p class="form-hint">Flexible scheduling — weekdays, evenings, weekends available</p>
          </div>
          
          <div class="form-group checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" name="newsletter" value="yes" />
              <span class="checkbox-custom"></span>
              <span>Send me occasional tech tips for seniors (monthly, unsubscribe anytime)</span>
            </label>
          </div>
          
          <button type="submit" class="btn btn-primary btn-submit">
            <span class="btn-text">Request Free Consultation</span>
            <span class="btn-loading" hidden>Sending...</span>
          </button>
          
          <p class="form-disclaimer">I'll respond within 24 hours. Your information is never shared.</p>
        </form>
        
        <div id="form-success" class="form-success" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <h3>Thanks for Reaching Out!</h3>
          <p>I'll be in touch within 24 hours to schedule your free consultation.</p>
        </div>
      </section>

      <section class="contact-section" aria-labelledby="contact-info-heading">
        <h2 id="contact-info-heading">Other Ways to Reach Me</h2>
        <div class="contact-methods">
          <a href={`tel:${business.telephone}`} class="contact-method">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="method-info">
              <h3>Phone</h3>
              <p>{business.telephone.replace('+1-', '')}</p>
              <span class="method-hours">Available for calls during business hours</span>
            </div>
          </a>
          
          <a href={`mailto:${business.email}`} class="contact-method">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="method-info">
              <h3>Email</h3>
              <p>{business.email}</p>
              <span class="method-hours">I respond within 24 hours</span>
            </div>
          </a>
          
          <div class="contact-method">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="method-info">
              <h3>Service Area</h3>
              <p>Ottawa, Barrhaven, Nepean, Kanata</p>
              <span class="method-hours">In-home sessions (travel included)</span>
            </div>
          </div>
          
          <div class="contact-method">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div class="method-info">
              <h3>Hours</h3>
              <p>Mon–Fri: 9am–7pm</p>
              <p>Sat: 10am–4pm</p>
              <span class="method-hours">Sessions by appointment only</span>
            </div>
          </div>
        </div>
      </section>

      <section class="contact-section" aria-labelledby="virtual-heading">
        <h2 id="virtual-heading">Virtual Sessions Available Anywhere</h2>
        <p>
          Not in the Ottawa area? No problem. Virtual sessions work beautifully via Zoom or FaceTime. 
          I can see your screen, guide you step-by-step, and you learn on your own device in your own home.
        </p>
        <ul class="virtual-benefits">
          <li><strong>Screen sharing</strong> — I see what you see, guide click-by-click</li>
          <li><strong>No travel needed</strong> — Learn from anywhere in Canada</li>
          <li><strong>Same personal attention</strong> — One-on-one, your pace, your goals</li>
          <li><strong>Recording option</strong> — Get a video recording of the session to review later</li>
        </ul>
      </section>

      <section class="contact-section" aria-labelledby="pricing-heading">
        <h2 id="pricing-heading">Simple, Transparent Pricing</h2>
        <div class="pricing-card">
          <div class="pricing-price">
            <span class="amount">$60</span>
            <span class="period">/ hour</span>
          </div>
          <ul class="pricing-includes">
            <li>One-on-one personal coaching</li>
            <li>Choose your topics and pace</li>
            <li>In-home or virtual sessions</li>
            <li>Session notes &amp; practice materials</li>
            <li>Flexible scheduling</li>
            <li>Free 15-min consultation included</li>
            <li>Ongoing email/text support between sessions</li>
          </ul>
          <div class="pricing-notes">
            <p><strong>No contracts.</strong> No minimum sessions. No hidden fees. Pay as you go.</p>
            <p><strong>Payment:</strong> Cash, credit card, or Interac e-Transfer after each session.</p>
          </div>
        </div>
      </section>
    </article>

    <aside class="contact-sidebar">
      <div class="sidebar-card info-card">
        <h3>Quick Answers</h3>
        <dl class="faq-list">
          <dt>Is there a free consultation?</dt>
          <dd>Yes! 15 minutes by phone or Zoom. No pressure, just chat about your goals.</dd>
          
          <dt>Do you teach both Mac and Windows?</dt>
          <dd>Absolutely. I coach on both macOS and Windows 10/11.</dd>
          
          <dt>What if I've never used a computer?</dt>
          <dd>That's exactly who I help! Many students start with zero experience.</dd>
          
          <dt>Do you offer virtual sessions?</dt>
          <dd>Yes — Zoom or FaceTime. Works great for iPad/iPhone and screen-sharing.</dd>
          
          <dt>Is there a minimum number of sessions?</dt>
          <dd>No. One session, ten sessions — entirely up to you.</dd>
          
          <dt>What areas for in-home sessions?</dt>
          <dd>Ottawa, Barrhaven, Nepean, Kanata. Just outside? Let's chat.</dd>
        </dl>
      </div>
      
      <div class="sidebar-card trust-card">
        <h3>Why Choose MacBryte?</h3>
        <ul class="trust-list">
          <li>800+ teaching hours</li>
          <li>75+ students helped</li>
          <li>4.9★ average rating</li>
          <li>No jargon, plain English</li>
          <li>Your device, your home</li>
          <li>No contracts, cancel anytime</li>
        </ul>
      </div>
    </aside>
  </main>
</Base>

<script>
  // Form handling
  const form = document.getElementById('booking-form');
  const success = document.getElementById('form-success');
  
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('.btn-submit');
      const btnText = submitBtn.querySelector('.btn-text');
      const btnLoading = submitBtn.querySelector('.btn-loading');
      
      submitBtn.disabled = true;
      btnText.hidden = true;
      btnLoading.hidden = false;
      
      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });
        
        if (response.ok) {
          form.hidden = true;
          success.hidden = false;
        } else {
          throw new Error('Form submission failed');
        }
      } catch (err) {
        console.error(err);
        alert('Something went wrong. Please try again or call directly.');
        submitBtn.disabled = false;
        btnText.hidden = false;
        btnLoading.hidden = true;
      }
    });
  }
</script>

<style>
  .page-header {
    padding: 4rem 0 2rem;
    background: linear-gradient(180deg, var(--color-primary-light, #eff6ff) 0%, white 100%);
    text-align: center;
  }

  .page-header h1 {
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.25rem;
    color: var(--color-gray-600, #4b5563);
    margin: 0;
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 3rem 0;
  }

  @media (min-width: 1024px) {
    .contact-content {
      grid-template-columns: 1fr 320px;
    }
  }

  .contact-section {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .contact-section:last-of-type {
    border-bottom: none;
  }

  .section-lead {
    color: var(--color-gray-600, #4b5563);
    margin-bottom: 2rem;
  }

  .contact-form {
    background: white;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .form-row { grid-template-columns: 1fr 1fr; }
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.5rem;
    color: var(--color-text, #1f2937);
  }

  .required {
    color: #dc2626;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    font-size: 1rem;
    font-family: inherit;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 8px;
    background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary, #1e40af);
    box-shadow: 0 0 0 3px var(--color-primary-light, #eff6ff);
  }

  .form-group select[multiple] {
    min-height: 120px;
  }

  .form-hint {
    font-size: 0.8125rem;
    color: var(--color-gray-500, #6b7280);
    margin: 0.375rem 0 0;
  }

  .checkbox-group {
    margin-bottom: 1.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-weight: 400;
    color: var(--color-gray-600, #4b5563);
  }

  .checkbox-custom {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-border, #e5e7eb);
    border-radius: 4px;
    margin-top: 0.125rem;
    position: relative;
    transition: all 0.2s;
  }

  .checkbox-label input:checked + .checkbox-custom {
    background: var(--color-primary, #1e40af);
    border-color: var(--color-primary, #1e40af);
  }

  .checkbox-label input:checked + .checkbox-custom::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-label input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .btn-submit {
    width: 100%;
    padding: 1.125rem 2rem;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .btn-primary {
    background: var(--color-primary, #1e40af);
    color: white;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--color-primary-dark, #1e3a8a);
    transform: translateY(-1px);
  }

  .btn-primary:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .form-disclaimer {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-gray-500, #6b7280);
    margin-top: 1.5rem;
  }

  .form-success {
    text-align: center;
    padding: 3rem;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 16px;
  }

  .form-success svg {
    width: 64px;
    height: 64px;
    color: #16a34a;
    margin-bottom: 1.5rem;
  }

  .form-success h3 {
    margin-bottom: 0.75rem;
  }

  .form-success p {
    color: var(--color-gray-600, #4b5563);
    margin: 0;
  }

  .contact-methods {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .contact-methods { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .contact-methods { grid-template-columns: repeat(4, 1fr); }
  }

  .contact-method {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
    background: white;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .contact-method:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .method-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-primary-light, #eff6ff);
    color: var(--color-primary, #1e40af);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .method-icon svg {
    width: 24px;
    height: 24px;
  }

  .method-info h3 {
    margin: 0 0 0.5rem;
    font-size: 1.0625rem;
  }

  .method-info p {
    margin: 0 0 0.25rem;
    font-weight: 500;
  }

  .method-hours {
    font-size: 0.8125rem;
    color: var(--color-gray-500, #6b7280);
  }

  .virtual-benefits {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .virtual-benefits li {
    background: white;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .pricing-card {
    background: white;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 16px;
    padding: 2.5rem;
    text-align: center;
  }

  .pricing-price {
    margin-bottom: 2rem;
  }

  .pricing-amount {
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-primary, #1e40af);
    line-height: 1;
  }

  .pricing-period {
    font-size: 1.25rem;
    color: var(--color-gray-500, #6b7280);
  }

  .pricing-includes {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }

  .pricing-includes li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--color-gray-100, #f3f4f6);
    border-radius: 8px;
  }

  .pricing-includes li::before {
    content: '✓';
    color: var(--color-primary, #1e40af);
    font-weight: bold;
    flex-shrink: 0;
  }

  .pricing-notes {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-gray-600, #4b5563);
  }

  .pricing-notes p {
    margin-bottom: 0.75rem;
  }

  .contact-sidebar {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .sidebar-card {
    background: white;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .sidebar-card h3 {
    margin: 0 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-list dt {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .faq-list dd {
    margin: 0;
    color: var(--color-gray-600, #4b5563);
    font-size: 0.9375rem;
  }

  .trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .trust-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--color-gray-100, #f3f4f6);
    border-radius: 8px;
  }

  .trust-list li::before {
    content: '✓';
    color: var(--color-primary, #1e40af);
    font-weight: bold;
  }
</style>