---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Thank you | Macbryte" description="Thanks — we'll call you back soon." path="/thanks" noindex>
  <section class="px-4 py-20 text-center max-w-2xl mx-auto">
    <h1 class="text-gray-900 mb-5">Thank you — we'll call you soon</h1>
    <p class="text-xl text-gray-700 mb-8">Usually within one business day. If it's urgent, call us now.</p>
    <a href={site.phoneHref} class="inline-flex rounded-full bg-coral-dark text-white font-bold px-8 py-4 text-xl">Call {site.phone}</a>
    <p class="mt-8"><a href="/" class="text-[#6B5CE7] underline">Back to the home page</a></p>
  </section>
</Base>
