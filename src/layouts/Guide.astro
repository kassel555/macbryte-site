---
// Guide.astro - Layout for guide/blog pages
import Base from './Base.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import CTA from '../components/CTA.astro'
// import Schema from '../components/Schema.astro'
import { business } from '../data/business.json'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'guides'>
}

const { entry } = Astro.props
const { data } = entry
const { render } = entry
const { id, title, description, shortDescription, heroImage, heroImageAlt, videoId, videoTitle, videoDuration, steps, cheatsheet, troubleshooting, relatedGuides, publishDate, updatedDate } = data

// Parse date strings to Date objects for formatting
const parsedPublishDate = new Date(publishDate)
const parsedUpdatedDate = updatedDate ? new Date(updatedDate) : null

const breadcrumbs = [
  { name: 'Guides', url: '/guides' },
  { name: title, url: `/guides/${id}` },
]

const structuredSteps = steps?.map((step, index) => ({
  '@type': 'HowToStep',
  position: index + 1,
  name: step.title,
  text: step.description,
  image: step.image || undefined,
  itemListElement: step.items?.map((item, i) => ({
    '@type': 'HowToDirection',
    position: i + 1,
    text: item,
  })) || [],
})) || []

// Helper function for related guides
function getGuideTitle(slug: string): string {
  const titles: Record<string, string> = {
    'how-to-setup-facetime-ipad-seniors': 'How to Set Up FaceTime on iPad for Seniors',
    'spot-phishing-scams-seniors': 'Spotting Phishing Scams Targeting Seniors',
    'ipad-accessibility-seniors': 'iPad Accessibility Settings for Vision & Hearing',
    'icloud-photos-explained': 'How to Organize Photos with Albums & iCloud',
    'best-ipad-for-seniors': 'Best iPad for Seniors 2025',
    'password-manager-seniors': 'Bitwarden Password Manager Setup for Seniors',
  }
  return titles[slug] || slug
}
---

<Base
  title={title}
  description={description}
  canonicalUrl={`/guides/${id}`}
  ogImage={heroImage || '/images/og-guide.jpg'}
  ogType="article"
>
  {render()}
</Base>
  <header class="guide-hero">
    <div class="container">
      <Breadcrumb items={breadcrumbs} />
      
      <div class="guide-hero-content">
        <div class="guide-meta">
          <time datetime={parsedPublishDate.toISOString()} class="publish-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {parsedPublishDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {parsedUpdatedDate && (
            <time datetime={parsedUpdatedDate.toISOString()} class="updated-date">
              Updated {parsedUpdatedDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          )}
        </div>
        
        <h1>{title}</h1>
        {shortDescription && <p class="guide-lead">{shortDescription}</p>}
        
        {videoId && (
          <div class="guide-video" style="--aspect-ratio: 16/9;">
            <iframe
              src={`https://www.youtube.com/embed/${videoId}`}
              title={videoTitle || `${title} - Video Tutorial`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        )}
      </div>
      
      {heroImage && (
        <div class="guide-hero-image">
          <img src={heroImage} alt={heroImageAlt || title} loading="eager" />
        </div>
      )}
    </div>
  </header>

  <article class="container guide-content">
    <div class="guide-main">
      <slot name="intro" />
      
      {steps && steps.length > 0 && (
        <section class="guide-steps" aria-labelledby="steps-heading">
          <h2 id="steps-heading">Step-by-Step Guide</h2>
          <ol class="steps-list">
            {steps.map((step, index) => (
              <li class="step-item" itemprop="step" itemtype="https://schema.org/HowToStep" itemscope>
                <div class="step-header">
                  <span class="step-counter" itemprop="position">{index + 1}</span>
                  <h3 itemprop="name">{step.title}</h3>
                </div>
                {step.description && <p itemprop="text">{step.description}</p>}
                {step.items && step.items.length > 0 && (
                  <ol class="step-details" itemprop="itemListElement" itemtype="https://schema.org/HowToDirection" itemscope>
                    {step.items.map((item, i) => (
                      <li itemprop="position" content={i + 1}>
                        <span itemprop="text">{item}</span>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}

      {cheatsheet && (
        <section class="guide-cheatsheet" aria-labelledby="cheatsheet-heading">
          <h2 id="cheatsheet-heading">{cheatsheet.title}</h2>
          <ul class="cheatsheet-list">
            {cheatsheet.items.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="cheatsheet-download">
            <a href={`/downloads/${id}-cheatsheet.pdf`} class="download-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download Printable PDF
            </a>
          </p>
        </section>
      )}

      {troubleshooting && troubleshooting.length > 0 && (
        <section class="guide-troubleshooting" aria-labelledby="troubleshooting-heading">
          <h2 id="troubleshooting-heading">Troubleshooting Quick Fixes</h2>
          <table class="troubleshooting-table">
            <thead>
              <tr>
                <th scope="col">Problem</th>
                <th scope="col">Solution</th>
              </tr>
            </thead>
            <tbody>
              {troubleshooting.map((item: any) => (
                <tr>
                  <td>{item.problem}</td>
                  <td>{item.solution}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}

      <section class="guide-cta" aria-labelledby="help-heading">
        <h2 id="help-heading">Still Need Help?</h2>
        <p>Book a free 15-minute consultation or personalized session — in-home or virtual.</p>
        <CTA variant="secondary" />
      </section>
    </div>

    <aside class="guide-sidebar" aria-label="Related guides">
      <div class="sidebar-card">
        <h3>Related Guides</h3>
        <ul class="related-guides">
          {relatedGuides?.map((guideId: string) => (
            <li>
              <a href={`/guides/${guideId}`}>{getGuideTitle(guideId)}</a>
            </li>
          ))}
          {(!relatedGuides || relatedGuides.length === 0) && (
            <>
              <li><a href="/guides/how-to-setup-facetime-ipad-seniors">How to Set Up FaceTime on iPad for Seniors</a></li>
              <li><a href="/guides/spot-phishing-scams-seniors">Spotting Phishing Scams Targeting Seniors</a></li>
              <li><a href="/guides/ipad-accessibility-seniors">iPad Accessibility Settings for Vision & Hearing</a></li>
              <li><a href="/guides/icloud-photos-explained">How to Organize Photos with Albums & iCloud</a></li>
              <li><a href="/guides/best-ipad-for-seniors">Best iPad for Seniors 2025</a></li>
              <li><a href="/guides/password-manager-seniors">Bitwarden Password Manager Setup for Seniors</a></li>
            </>
          )}
        </ul>
      </div>
      
      <div class="sidebar-card">
        <h3>Get Personalized Help</h3>
        <p>One-on-one coaching tailored to you.</p>
        <CTA variant="inline" buttonText="Book Free Consultation" />
      </div>
    </aside>
  </article>
</Base>

<style>
  .guide-hero {
    padding: 2rem 0;
    background: white;
  }

  .guide-hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .guide-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-gray-500, #6b7280);
  }

  .guide-meta time {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .guide-meta svg {
    width: 16px;
    height: 16px;
  }

  .guide-hero h1 {
    margin-bottom: 1rem;
  }

  .guide-lead {
    font-size: 1.25rem;
    color: var(--color-gray-600, #4b5563);
    margin-bottom: 2rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .guide-video {
    position: relative;
    width: 100%;
    padding-bottom: calc(var(--aspect-ratio) * 100%);
    border-radius: 12px;
    overflow: hidden;
    margin: 0 auto 2rem;
    max-width: 800px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
  }

  .guide-video iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .guide-hero-image {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    max-width: 800px;
    margin: 0 auto;
  }

  .guide-hero-image img {
    width: 100%;
    height: auto;
  }

  .guide-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 3rem 0;
  }

  @media (min-width: 1024px) {
    .guide-content {
      grid-template-columns: 1fr 280px;
    }
  }

  .guide-main {
    min-width: 0;
  }

  .guide-steps {
    margin-bottom: 3rem;
  }

  .guide-steps h2 {
    margin-bottom: 2rem;
  }

  .steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .step-item {
    background: white;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 12px;
    padding: 2rem;
  }

  .step-header {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .step-counter {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary, #1e40af);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .step-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .step-item > p {
    margin-left: 75px;
    color: var(--color-gray-600, #4b5563);
    margin-bottom: 1rem;
    padding-right: 2rem;
  }

  .step-details {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-left: 75px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .step-details li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--color-gray-100, #f3f4f6);
    border-radius: 8px;
    color: var(--color-text, #1f2937);
  }

  .step-details li::before {
    content: '→';
    color: var(--color-primary, #1e40af);
    font-weight: bold;
    flex-shrink: 0;
  }

  .guide-cheatsheet {
    background: var(--color-primary-light, #eff6ff);
    border: 1px solid var(--color-primary, #1e40af);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 3rem;
  }

  .guide-cheatsheet h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: var(--color-primary-dark, #1e3a8a);
  }

  .cheatsheet-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .cheatsheet-list { grid-template-columns: repeat(2, 1fr); }
  }

  .cheatsheet-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: white;
    border-radius: 8px;
    font-size: 0.9375rem;
  }

  .cheatsheet-list li::before {
    content: '✓';
    color: var(--color-primary, #1e40af);
    font-weight: bold;
  }

  .cheatsheet-download {
    text-align: center;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary, #1e40af);
    color: white;
    border-radius: 9999px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }

  .download-link:hover {
    background: var(--color-primary-dark, #1e3a8a);
    color: white;
    text-decoration: none;
  }

  .download-link svg {
    width: 20px;
    height: 20px;
  }

  .guide-troubleshooting {
    margin-bottom: 3rem;
  }

  .guide-troubleshooting h2 {
    margin-bottom: 1.5rem;
  }

  .troubleshooting-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .troubleshooting-table th,
  .troubleshooting-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .troubleshooting-table th {
    background: var(--color-gray-100, #f3f4f6);
    font-weight: 600;
    color: var(--color-text, #1f2937);
  }

  .troubleshooting-table td {
    color: var(--color-gray-600, #4b5563);
  }

  .troubleshooting-table tr:last-child td {
    border-bottom: none;
  }

  .guide-cta {
    background: white;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
  }

  .guide-cta h2 {
    margin-top: 0;
  }

  .guide-cta p {
    margin-bottom: 1.5rem;
  }

  .guide-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-card {
    background: white;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .sidebar-card h3 {
    margin: 0 0 1rem;
    font-size: 1.0625rem;
  }

  .related-guides {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-guides a {
    display: block;
    padding: 0.75rem;
    border-radius: 8px;
    color: var(--color-text, #1f2937);
    font-size: 0.9375rem;
    transition: background 0.2s, color 0.2s;
  }

  .related-guides a:hover {
    background: var(--color-primary-light, #eff6ff);
    color: var(--color-primary, #1e40af);
    text-decoration: none;
  }
</style>