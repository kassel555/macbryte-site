---
import { site, services } from '../data/site';
const areas = [
  ['/computer-coaching-ottawa', 'Ottawa'], ['/computer-coaching-kanata', 'Kanata'],
  ['/computer-coaching-barrhaven', 'Barrhaven'], ['/computer-coaching-nepean', 'Nepean'],
];
const year = new Date().getFullYear();
---
<footer class="bg-gray-50 border-t border-gray-100 px-4 md:px-8 pt-12 pb-8">
  <div class="max-w-6xl mx-auto grid gap-10 md:grid-cols-4">
    <div>
      <img src="/images/logo.png" alt="Macbryte" width="137" height="40" class="h-10 w-auto mb-4" />
      <p class="text-gray-600 text-base">Patient, one-on-one computer lessons for seniors and beginners — Mac or PC, at home or online.</p>
    </div>
    <div>
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Talk to us</h2>
      <ul class="space-y-2 text-gray-700">
        <li><a class="text-xl font-semibold text-coral-dark hover:underline" href={site.phoneHref}>{site.phone}</a></li>
        <li><a class="hover:underline" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="hover:underline" href="/contact">Request a callback</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Popular help</h2>
      <ul class="space-y-1.5">
        {services.map((s) => <li><a class="text-gray-700 hover:text-coral-dark" href={s.href}>{s.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Areas we serve</h2>
      <ul class="space-y-1.5">
        {areas.map(([href, label]) => <li><a class="text-gray-700 hover:text-coral-dark" href={href}>{label}</a></li>)}
      </ul>
      <h2 class="text-lg font-semibold text-gray-900 mt-6 mb-3">More</h2>
      <ul class="space-y-1.5">
        <li><a class="text-gray-700 hover:text-coral-dark" href="/what-you-learn">All courses</a></li>
        <li><a class="text-gray-700 hover:text-coral-dark" href="/blog">Tips &amp; blog</a></li>
      </ul>
    </div>
  </div>
  <div class="max-w-6xl mx-auto mt-10 pt-6 border-t border-gray-200 flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-500">
    <span>© {year} Macbryte</span>
    <a class="hover:underline" href="/terms">Terms</a>
    <a class="hover:underline" href="/privacy">Privacy</a>
    <a class="hover:underline" href="/cookies">Cookies</a>
  </div>
</footer>
