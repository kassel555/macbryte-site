  return guides[guideId] || null;
}

function faqPageSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${biz.url}#faq`,
    mainEntity: (biz.faqs || []).map((faq: any) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  };
}

function breadcrumbSchema(items: Array<{ name: string; url: string }>) {
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: (items || []).map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: `${biz.url}${item.url}`,
    })),
  };
}

function webSiteSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${biz.url}#website`,
    url: biz.url,
    name: biz.name,
    publisher: { '@id': `${biz.url}#business` },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${biz.url}/?s={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  };
}

const { type, data, serviceId, guideId } = Astro.props;

let schema: any = null;

switch (type) {
  case 'LocalBusiness':
    schema = localBusinessSchema();
    break;
  case 'Service':
    schema = serviceSchema(serviceId!);
    break;
  case 'Person':
    schema = personSchema();
    break;
  case 'HowTo':
    schema = howToSchema(guideId!);
    break;
  case 'FAQPage':
    schema = faqPageSchema();
    break;
  case 'BreadcrumbList':
    schema = breadcrumbSchema(data?.items || []);
    break;
  case 'WebSite':
    schema = webSiteSchema();
    break;
}

let output = null;
if (schema) {
  // Combine multiple schemas into @graph if needed
  output = schema['@graph'] ? schema : { '@context': 'https://schema.org', '@graph': [schema] };
}
---

{output && (
  <script type="application/ld+json" set:html={JSON.stringify(output)} />
)}

<script is:inline>
  // This component only outputs JSON-LD in the head via the layout
</script>