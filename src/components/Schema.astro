---
// Schema.astro - Injects JSON-LD structured data based on page type
import businessData from '../data/business.json';

interface Props {
  type: 'LocalBusiness' | 'Service' | 'Person' | 'HowTo' | 'FAQPage' | 'BreadcrumbList' | 'WebSite';
  data?: Record<string, any>;
  serviceId?: string;
  guideId?: string;
}

const biz = businessData.business;

function localBusinessSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${biz.url}#business`,
    name: biz.name,
    description: biz.description,
    url: biz.url,
    telephone: biz.telephone,
    email: biz.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: biz.address.addressLocality,
      addressRegion: biz.address.addressRegion,
      addressCountry: biz.address.addressCountry,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: biz.geo?.latitude,
      longitude: biz.geo?.longitude,
    },
    areaServed: (biz.areaServed || []).map((area: any) => ({
      '@type': area.type,
      name: area.name,
    })),
    priceRange: biz.priceRange,
    currenciesAccepted: biz.currenciesAccepted,
    paymentAccepted: biz.paymentAccepted,
    openingHoursSpecification: (biz.openingHours || []).map((hours: any) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: hours.dayOfWeek,
      opens: hours.opens,
      closes: hours.closes,
    })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Computer Coaching Services',
      itemListElement: (biz.services || []).map((svc: any, index: number) => ({
        '@type': 'Offer',
        position: index + 1,
        itemOffered: {
          '@type': 'Service',
          '@id': `${biz.url}${svc.url}#service`,
          name: svc.name,
          description: svc.description,
          provider: { '@id': `${biz.url}#business` },
          areaServed: svc.areas,
          serviceType: svc.serviceType,
        },
        price: svc.price,
        priceCurrency: svc.priceCurrency,
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: svc.price,
          priceCurrency: svc.priceCurrency,
          unitText: svc.unitText,
        },
      })),
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: biz.aggregateRating.ratingValue,
      reviewCount: biz.aggregateRating.reviewCount,
      bestRating: biz.aggregateRating.bestRating,
      worstRating: biz.aggregateRating.worstRating,
    },
    review: (biz.reviews || []).map((review: any) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: review.author },
      datePublished: review.datePublished,
      reviewBody: review.reviewBody,
      reviewRating: {
        '@type': 'Rating',
        ratingValue: review.ratingValue,
        bestRating: '5',
      },
      publisher: { '@id': `${biz.url}#business` },
    })),
    sameAs: biz.sameAs,
  };
}

function serviceSchema(serviceId: string) {
  const svc = biz.services.find((s: any) => s.id === serviceId);
  if (!svc) return null;

  return {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${biz.url}${svc.url}#service`,
    name: svc.name,
    description: svc.description,
    provider: { '@id': `${biz.url}#business` },
    areaServed: (svc.areas || []).map((area: string) => ({
      '@type': 'City',
      name: area,
    })),
    serviceType: svc.serviceType,
    offers: {
      '@type': 'Offer',
      price: svc.price,
      priceCurrency: svc.priceCurrency,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: svc.price,
        priceCurrency: svc.priceCurrency,
        unitText: svc.unitText,
      },
    },
  };
}

function personSchema() {
  const founder = biz.founder;
  return {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': `${biz.url}/about#person`,
        name: founder.name,
        alternateName: `${founder.name} MacBryte`,
        description: founder.description,
        url: `${biz.url}/about`,
        image: founder.image,
        sameAs: founder.sameAs,
        jobTitle: founder.jobTitle,
        worksFor: { '@id': `${biz.url}#business` },
        knowsAbout: (founder.knowsAbout || []).map((topic: string) => topic),
        credential: (founder.credentials || []).map((cred: any) => ({
          '@type': 'EducationalOccupationalCredential',
          name: cred.name,
          description: cred.description,
        })),
        award: {
          '@type': 'AggregateRating',
          ratingValue: founder.award.ratingValue,
          reviewCount: founder.award.reviewCount,
          bestRating: founder.award.bestRating,
          worstRating: founder.award.worstRating,
          description: `Average rating from student and family reviews on Google and Facebook`,
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: biz.address.addressLocality,
          addressRegion: biz.address.addressRegion,
          addressCountry: biz.address.addressCountry,
        },
      },
      {
        '@type': 'AboutPage',
        '@id': `${biz.url}/about#page`,
        url: `${biz.url}/about`,
        name: `About ${biz.name} & ${founder.name}`,
        mainEntity: { '@id': `${biz.url}/about#person` },
        publisher: { '@id': `${biz.url}#business` },
      },
    ],
  };
}

