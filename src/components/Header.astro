---
import { site, nav } from '../data/site';
const { current = '' } = Astro.props;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-4 md:px-8 h-20 flex items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label="Macbryte home">
      <img src="/images/logo.png" alt="Macbryte" width="164" height="48" class="h-11 w-auto" />
    </a>

    <nav aria-label="Main" class="hidden lg:flex items-center gap-6">
      {nav.map((n) => (
        <a href={n.href} class:list={['text-[17px] font-medium hover:text-coral-dark', isActive(n.href) ? 'text-coral-dark' : 'text-gray-700']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={site.phoneHref} class="hidden sm:inline-flex items-center gap-2 rounded-full bg-coral-dark hover:bg-coral text-white font-semibold px-5 py-3 text-lg">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {site.phone}
      </a>

      <!-- Mobile menu: works without JavaScript -->
      <details class="lg:hidden relative group">
        <summary class="list-none cursor-pointer rounded-full border border-gray-300 px-4 py-2.5 text-lg font-medium text-gray-800 select-none">
          <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-3 w-64 rounded-2xl bg-white shadow-xl border border-gray-100 p-2">
          {nav.map((n) => (
            <a href={n.href} class="block rounded-xl px-4 py-3 text-lg text-gray-800 hover:bg-[#f2f1fa]">{n.label}</a>
          ))}
          <a href={site.phoneHref} class="block rounded-xl px-4 py-3 text-lg font-semibold text-coral-dark">Call {site.phone}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
